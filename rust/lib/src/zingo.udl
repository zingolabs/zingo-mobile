[Error]
interface ZingolibError {
    LightclientNotInitialized();
    LightclientLockPoisoned();
    Panic(string message);
    InvalidInput(string message);
    ProposalFailed(string message);
    SendFailed(string message);
    WalletError(string message);
};

dictionary BalancesInfo {
    u64 total_orchard_balance;
    u64 total_sapling_balance;
    u64 total_transparent_balance;
    u64 confirmed_orchard_balance;
    u64 confirmed_sapling_balance;
    u64 confirmed_transparent_balance;
    u64 unconfirmed_orchard_balance;
    u64 unconfirmed_sapling_balance;
    u64 unconfirmed_transparent_balance;
};

dictionary SpendableBalanceInfo {
    u64 spendable_balance;
};

dictionary WalletHeightInfo {
    u32 height;
};

dictionary WalletVersionInfo {
    u32 current_version;
    u32 read_version;
};

dictionary WalletSaveRequiredInfo {
    boolean save_required;
};

dictionary SeedInfo {
    string seed_phrase;
    u32 birthday;
    u32 no_of_accounts;
};

dictionary UfvkInfo {
    string ufvk;
    u32 birthday;
};

dictionary ProposalInfo {
    u64 fee;
};

dictionary ShieldProposalInfo {
    u64 fee;
    u64 value_to_shield;
};

dictionary ConfirmInfo {
    sequence<string> txids;
};

dictionary PerformanceInfo {
    string performance_level;
};

namespace zingo {

  [Throws=ZingolibError]
  string init_logging();

  [Throws=ZingolibError]
  SeedInfo init_new(
      string serveruri,
      string chainhint,
      string performancelevel,
      u32 minconfirmations
  );

  [Throws=ZingolibError]
  SeedInfo init_from_seed(
      string seed_phrase,
      u32 birthday,
      string serveruri,
      string chainhint,
      string performancelevel,
      u32 minconfirmations
  );

  [Throws=ZingolibError]
  UfvkInfo init_from_ufvk(
      string ufvk,
      u32 birthday,
      string serveruri,
      string chainhint,
      string performancelevel,
      u32 minconfirmations
  );

  [Throws=ZingolibError]
  string init_from_b64(
      string datab64,
      string serveruri,
      string chainhint,
      string performancelevel,
      u32 minconfirmations
  );

  [Throws=ZingolibError]
  string save_to_b64();

  string check_b64(
    string datab64
  );

  [Throws=ZingolibError]
  string get_latest_block_server(
    string serveruri
  );

  [Throws=ZingolibError]
  WalletHeightInfo get_latest_block_wallet();

  [Throws=ZingolibError]
  string get_developer_donation_address();

  [Throws=ZingolibError]
  string get_zennies_for_zingo_donation_address();

  [Throws=ZingolibError]
  string get_value_transfers();

  [Throws=ZingolibError]
  string set_crypto_default_provider_to_ring();

  [Throws=ZingolibError]
  string poll_sync();

  [Throws=ZingolibError]
  string run_sync();

  [Throws=ZingolibError]
  string pause_sync();

  [Throws=ZingolibError]
  string status_sync();

  [Throws=ZingolibError]
  string run_rescan();

  [Throws=ZingolibError]
  string info_server();

  [Throws=ZingolibError]
  SeedInfo get_seed();

  [Throws=ZingolibError]
  UfvkInfo get_ufvk();

  [Throws=ZingolibError]
  string change_server(
    string serveruri
  );

  [Throws=ZingolibError]
  string wallet_kind();

  [Throws=ZingolibError]
  string parse_address(
    string address
  );

  [Throws=ZingolibError]
  string parse_ufvk(
    string ufvk
  );

  [Throws=ZingolibError]
  string get_version();

  [Throws=ZingolibError]
  string get_messages(
    string address
  );

  [Throws=ZingolibError]
  BalancesInfo get_balance();

  [Throws=ZingolibError]
  string get_total_memobytes_to_address();

  [Throws=ZingolibError]
  string get_total_value_to_address();

  [Throws=ZingolibError]
  string get_total_spends_to_address();

  [Throws=ZingolibError]
  string zec_price(
    string tor
  );

  [Throws=ZingolibError]
  string remove_transaction(
    string txid
  );

  [Throws=ZingolibError]
  string get_spendable_balance_with_address(
    string address,
    string zennies
  );

  [Throws=ZingolibError]
  SpendableBalanceInfo get_spendable_balance_total();

  [Throws=ZingolibError]
  string create_tor_client(
    string datadir
  );

  [Throws=ZingolibError]
  string remove_tor_client();

  [Throws=ZingolibError]
  string get_unified_addresses();

  [Throws=ZingolibError]
  string get_transparent_addresses();

  [Throws=ZingolibError]
  string create_new_unified_address(
    string receivers
  );

  [Throws=ZingolibError]
  string create_new_transparent_address();

  [Throws=ZingolibError]
  string check_my_address(
    string address
  );

  [Throws=ZingolibError]
  WalletSaveRequiredInfo get_wallet_save_required();

  [Throws=ZingolibError]
  string set_config_wallet_to_test();

  [Throws=ZingolibError]
  string set_config_wallet_to_prod(
      string performancelevel,
      u32 minconfirmations
  );

  [Throws=ZingolibError]
  PerformanceInfo get_config_wallet_performance();

  [Throws=ZingolibError]
  WalletVersionInfo get_wallet_version();

  [Throws=ZingolibError]
  ProposalInfo send(
    string send_json
  );

  [Throws=ZingolibError]
  ShieldProposalInfo shield();

  [Throws=ZingolibError]
  ConfirmInfo confirm();
};
