dictionary ProbeFailure {
  string stage;
  string target;
  sequence<string> cause_chain;
};

dictionary MixnetDeathReport {
  u64 age_millis;
  ProbeFailure? detail;
};

dictionary MixnetTiming {
  u64 attach_readiness_budget_millis;
  u64 mixnet_round_trip_bound_millis;
};

dictionary ProbeSuccessData {
  string chain;
  u64 height;
};

[Enum]
interface ProbeLegOutcome {
  Answered(ProbeSuccessData info);
  Failed(ProbeFailure failure);
};

dictionary ProbeLeg {
  u64 millis;
  ProbeLegOutcome outcome;
};

[Enum]
interface MixnetLeg {
  Probed(ProbeLeg leg);
  NotCarried();
};

dictionary ProbeReport {
  string host;
  ProbeLeg clearnet;
  MixnetLeg mixnet;
};

[Enum]
interface SyncStageOutcome {
  Passed();
  Failed(ProbeFailure failure);
};

dictionary SyncProbeStage {
  string step;
  u64 millis;
  SyncStageOutcome outcome;
};

[Enum]
interface SyncServerVerdict {
  Reachable(ProbeSuccessData info);
  Stopped();
};

dictionary SyncServerProbe {
  string server;
  sequence<SyncProbeStage> stages;
  SyncServerVerdict verdict;
};
