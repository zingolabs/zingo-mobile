# Resolve script with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
'require.resolve(
  "react-native/scripts/react_native_pods.rb",
  {paths: [process.argv[1]]},
)', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!
 
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Zingo' do
  project 'Zingo.xcodeproj', 'Debug-Beta' => :debug, 'Release-Beta' => :release

  # Pods for Zingo
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ZingoTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    min = min_ios_version_supported.to_s
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=iphonesimulator*]'] = min
      end
    end

    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Download Hermes dSYMs if not present (needed for Release builds).
    # Version is read from package.json so it stays in sync automatically.
    require 'json'
    ios_root   = Pod::Config.instance.installation_root.to_s
    rn_version = JSON.parse(File.read(File.join(ios_root, '..', 'package.json'))).dig('dependencies', 'react-native').gsub(/[^0-9.]/, '')
    dsym_base  = File.join(ios_root, "vendor/hermes-dsyms/RN-#{rn_version}/ios-arm64/release")
    dsym_check = File.join(dsym_base, "iphoneos/hermes.framework.dSYM")

    Pod::UI.puts "Hermes dSYM base: #{dsym_base}".cyan
    Pod::UI.puts "Hermes dSYM check: #{dsym_check}".cyan
    unless File.exist?(dsym_check)
      Pod::UI.puts "Downloading Hermes dSYMs for React Native #{rn_version}...".yellow
      system("mkdir -p '#{dsym_base}'")
      url = "https://repo1.maven.org/maven2/com/facebook/react/react-native-artifacts/#{rn_version}/react-native-artifacts-#{rn_version}-hermes-framework-dSYM-release.tar.gz"
      ok = system("curl -L '#{url}' | tar -xz -C '#{dsym_base}'")
      Pod::UI.puts(ok ? "Hermes dSYM download OK".green : "ERROR: Hermes dSYM download failed".red)
    else
      Pod::UI.puts "Hermes dSYMs already present, skipping download.".green
    end
  end
end