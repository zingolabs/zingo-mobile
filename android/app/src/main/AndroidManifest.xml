<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Android 13+: batch reminders for the private Ironwood migration. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      notifee's core AAR auto-merges SCHEDULE_EXACT_ALARM for its exact-alarm
      types. Our reminders use AlarmManager with the INEXACT
      SET_AND_ALLOW_WHILE_IDLE type (see app/notifications/reminders.ts), which
      needs no exact-alarm permission, so strip it to avoid Google Play's
      exact-alarm policy declaration. RECEIVE_BOOT_COMPLETED + notifee's
      NotificationAlarmReceiver (also from the AAR) restore the alarms after
      reboot.
      If a trigger ever opts into an exact type (SET_EXACT,
      SET_EXACT_AND_ALLOW_WHILE_IDLE, SET_ALARM_CLOCK), remove this line and
      add the runtime openAlarmPermissionSettings() gate: without the
      permission notifee silently skips scheduling those.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!-- allowBackup="false": wallet files rest as plain zingolib bytes, and
         backup exclusion is their only guard against a stale device backup
         restoring an old wallet over a newer one. It must never flip to true. -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/zingo"
      android:roundIcon="@mipmap/zingo_round"
      android:allowBackup="false"
      android:largeHeap="true"
      android:enableOnBackInvokedCallback="false"
      android:hardwareAccelerated="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <uses-library android:name="org.apache.http.legacy" android:required="false"/>
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:screenOrientation="portrait">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <intent-filter>
            <action   android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data     android:scheme="zcash"/>
        </intent-filter>
      </activity>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="*" />
        </intent>
    </queries>

</manifest>
