{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["**/node_modules", "**/Pods", "rust/target", "scripts/release/**"],
  "compilerOptions": {
    "types": [
      "node", "jest"
    ],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["app/*"],
      "@screens/*": ["screens/*"],
      "@ui/*": ["ui/*"]
    }
  },
}
