{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["**/node_modules", "**/Pods", "scripts/release/**"],
  "compilerOptions": {
    "types": [
      "node", "jest"
    ],
    "paths": {
      "@app/*": ["./app/*"],
      "@screens/*": ["./screens/*"],
      "@ui/*": ["./ui/*"]
    }
  },
}
