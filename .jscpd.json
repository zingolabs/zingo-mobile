{
  "format": [
    "typescript",
    "tsx",
    "kotlin",
    "swift"
  ],
  "path": [
    "app",
    "screens",
    "ui",
    "__tests__",
    "__mocks__",
    ".storybook",
    "scripts",
    "visual",
    "android/app/src",
    "ios"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/Pods/**",
    "android/app/src/main/java/uniffi/**",
    "**/__snapshots__/**",
    "**/*.d.ts"
  ],
  "minTokens": 50,
  "minLines": 5,
  "reporters": [
    "console"
  ],
  "gitignore": true
}
